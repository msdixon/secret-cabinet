# Anthropic
ANTHROPIC_API_KEY=your-key-here

# Model id used for all salon generation calls — override to test a different tier
# Leave unset to use the current default (claude-sonnet-4-6)
MODEL=

# Server
PORT=3132

# Set to 'true' when running locally to enable Ulysses + Obsidian exports
# Leave unset (or set NODE_ENV=production) for deployed instances
LOCAL=true

# Passphrase auth — set this on Railway to protect the deployed instance
# Leave unset for local dev (no auth required)
PASSPHRASE=

# Random secret for session cookies — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required on a deployed instance once PASSPHRASE is set — the server refuses
# to start without it rather than falling back to a shared, insecure default.
SESSION_SECRET=

# Not set here — Railway injects this automatically when a volume is attached
# to the service. When present, convene data (sessions/), auth sessions
# (.auth-sessions/), and the ElevenLabs voice cache (voice-cache/, see below)
# are written under it instead of the app directory, so they survive
# redeploys. Attach a volume from the Railway dashboard to enable this on a
# deployed instance; nothing else to configure.
# RAILWAY_VOLUME_MOUNT_PATH=

# ElevenLabs — optional, higher-quality per-member TTS for Witness playback
# (#29). Leave unset to use the browser's built-in Web Speech API instead —
# the app works fully either way, this only upgrades the voice quality.
# Get a key at https://elevenlabs.io (the Starter tier is enough for this).
ELEVENLABS_API_KEY=

# ElevenLabs model id used for synthesis. eleven_turbo_v2_5 is the default:
# lower cost and latency than the multilingual model, at a quality bar that's
# fine for this. Override to try eleven_multilingual_v2 or a newer model.
ELEVENLABS_MODEL_ID=

# Comma-separated ElevenLabs voice IDs to assign members from (roster.js
# hashes each memberId into this pool deterministically — see FALLBACK_VOICE_IDS
# there for the default). Check your account's Voice Library at
# https://elevenlabs.io/app/voice-library before relying on the default pool;
# it's the historically-standard premade set, not guaranteed present in every
# account. Leave unset to use that default.
# ELEVENLABS_VOICE_POOL=

# Gemini API — optional, for portrait generation (see #435). Get a key at
# https://aistudio.google.com/apikey (needs a billing-enabled Cloud project
# for image-gen models at any real volume — the free tier rate-limits them
# hard). Leave unset to keep portrait generation fully manual, same as today.
GEMINI_API_KEY=

# ── Per-user sign-in (#594) ──────────────────────────────────────────────────
# With PASSPHRASE set, invitees sign in with a 6-digit code emailed to them;
# the passphrase becomes the break-glass admin login. The admin adds guests
# at /admin/users (the "Guest List" link on the mantel).

# The admin's own email, so emailed-code sign-in reaches the same account the
# passphrase does. Only applied if the admin doesn't already have one.
ADMIN_EMAIL=

# Resend (https://resend.com) API key for sending codes and invitations.
# Unset locally: codes are printed to the server console instead.
# Unset on a deployed instance: email sign-in is off, passphrase only.
RESEND_API_KEY=

# Sender address — its domain must be verified in Resend. Defaults to
# "The Secret-Cabin-et <lodge@mail.archon-salon.org>".
EMAIL_FROM=

# Public base URL that invitation emails link to. Defaults to
# https://archon-salon.org.
APP_URL=

# Monthly Anthropic budget in USD (#624). When month-to-date spend reaches 80%
# of this, the admin is emailed once that month and /admin/users shows a
# banner — a prompt to decide on a per-guest cap, not a block. Unset: spend is
# still shown per user, nothing alerts.
MONTHLY_BUDGET_USD=

# Optional: ElevenLabs USD per 1,000 characters on your plan, so /admin/users
# can show an estimated voice dollar figure next to character counts.
ELEVENLABS_USD_PER_1K_CHARS=
