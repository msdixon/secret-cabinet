# Anthropic
ANTHROPIC_API_KEY=your-key-here

# Model id used for all salon generation calls — override to test a different tier
# Leave unset to use the current default (claude-sonnet-4-6)
MODEL=

# Server
PORT=3132

# Set to 'true' when running locally to enable Ulysses + Obsidian exports
# Leave unset (or set NODE_ENV=production) for deployed instances
LOCAL=true

# Passphrase auth — set this on Railway to protect the deployed instance
# Leave unset for local dev (no auth required)
PASSPHRASE=

# Random secret for session cookies — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required on a deployed instance once PASSPHRASE is set — the server refuses
# to start without it rather than falling back to a shared, insecure default.
SESSION_SECRET=

# Not set here — Railway injects this automatically when a volume is attached
# to the service. When present, convene data (sessions/) and auth sessions
# (.auth-sessions/) are written under it instead of the app directory, so they
# survive redeploys. Attach a volume from the Railway dashboard to enable this
# on a deployed instance; nothing else to configure.
# RAILWAY_VOLUME_MOUNT_PATH=
