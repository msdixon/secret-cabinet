{
  "name": "secret-cabinet",
  "version": "1.0.0",
  "description": "The Secret-Cabin-et — a lodge salon for historical esotericists",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "predev": "npm install --no-audit --no-fund",
    "dev": "node --watch server.js",
    "update": "git pull origin main && npm install && lsof -ti :3132 | xargs kill -9 2>/dev/null; npm run dev",
    "citations": "node scripts/build-citation-manifest.js",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "babylonjs": "^9.18.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "multer": "^2.1.1",
    "pdf2json": "^4.0.3",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
