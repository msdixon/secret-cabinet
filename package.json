{
  "name": "secret-cabinet",
  "version": "1.0.0",
  "description": "The Secret-Cabin-et — a lodge salon for historical esotericists",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "predev": "npm install --no-audit --no-fund",
    "dev": "node --watch server.js",
    "update": "git pull origin main && npm install && lsof -ti :${PORT:-3132} | xargs kill -9 2>/dev/null; npm run dev",
    "citations": "node scripts/build-citation-manifest.js",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "babylonjs": "^9.20.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "multer": "^2.2.0",
    "pdf2json": "^4.0.3",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6"
  }
}
